# TronMonitor API ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri kendi ortamınıza göre düzenleyin.
# .env dosyası asla sürüm kontrolüne eklenmemelidir.

# Çalışma ortamı: development | production | test
NODE_ENV=development

# API'nin dinleyeceği adres ve port
API_HOST=127.0.0.1
API_PORT=4000

# Web arayüzünün adresi (CORS ve çerez ayarları için)
WEB_ORIGIN=http://localhost:3000

# PostgreSQL bağlantı adresi
DATABASE_URL=postgresql://tronmonitor:parola@127.0.0.1:5432/tronmonitor?schema=public

# Redis bağlantı adresi
REDIS_URL=redis://127.0.0.1:6379

# Oturum çerezleri için gizli anahtar (en az 32 karakter, rastgele üretin)
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=degistirin-en-az-32-karakter-rastgele-deger

# Oturum süresi (saat)
SESSION_TTL_HOURS=24

# Üretim ortamında çerezlerin yalnızca HTTPS üzerinden gönderilmesi
COOKIE_SECURE=false

# İlk süper yönetici hesabı (yalnızca veritabanında hiç kullanıcı yokken kullanılır)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
