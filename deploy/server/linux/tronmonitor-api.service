[Unit]
Description=TronMonitor API (NestJS)
Documentation=https://github.com/aclxkatirant/TronMonitor
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=tronmonitor
Group=tronmonitor
WorkingDirectory=/opt/tronmonitor/app/apps/api
EnvironmentFile=/etc/tronmonitor/api.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

# Sertleştirme: yalnızca gerekli yollara yazma; ICMP kontrolleri için ping'e CAP_NET_RAW verilir.
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/tronmonitor /var/log/tronmonitor
UMask=0027

[Install]
WantedBy=multi-user.target
