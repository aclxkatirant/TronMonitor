# Günlük otomatik yedek. Etkinleştirmek için:
#   sudo cp tronmonitor-backup.service tronmonitor-backup.timer /etc/systemd/system/
#   sudo systemctl enable --now tronmonitor-backup.timer
[Unit]
Description=TronMonitor günlük yedek zamanlayıcısı

[Timer]
OnCalendar=*-*-* 03:15:00
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
